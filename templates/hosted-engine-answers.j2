[environment:default]
OVEHOSTED_CORE/deployProceed=bool:True
OVEHOSTED_CORE/screenProceed=bool:True
OVEHOSTED_CORE/confirmSettings=bool:True

[environment:init]
OVEHOSTED_NETWORK/bridgeName=str:ovirtmgmt
OVEHOSTED_NETWORK/gateway=str:{{ engine_gateway }}
OVEHOSTED_NETWORK/fqdn=str:{{ engine_fqdn }}

[environment:append]
OVEHOSTED_NETWORK/host_name=str:{{ ansible_fqdn }}
OVEHOSTED_ENGINE/adminPassword=str:{{ engine_password }}
OVEHOSTED_ENGINE/appHostName=str:{{ engine_fqdn }}

OVEHOSTED_VM/vmMemSizeMB=int:{{ engine_vm_memory }}
OVEHOSTED_VM/vmVCpus=str:{{ engine_vm_vcpus }}
OVEHOSTED_VM/cloudinitRootPwd=str:{{ engine_root_password }}

OVEHOSTED_STORAGE/storageDomainConnection=str:{{ local_storage_path }}
OVEHOSTED_STORAGE/storageDatacenterName=str:Default
OVEHOSTED_STORAGE/domainType=str:glusterfs
OVEHOSTED_STORAGE/storageDomainName=str:hosted_storage

OVEHOSTED_VDSM/cpu=str:model_Skylake-Server-noTSX-IBRS

OVEHOSTED_VM/vmBoot=str:disk
OVEHOSTED_VM/ovfArchive=str: